# Single origin for the browser: the console and the API share cookies and WebSockets.
{
	admin off
}

:8787 {
	encode gzip
	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
	}
	@api path /api/*
	handle @api {
		reverse_proxy api:8000
	}
	handle {
		reverse_proxy web:3000
	}
}
