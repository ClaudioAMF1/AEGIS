# Copy to .env and fill in. Never commit .env.
# Generate secrets with:  python3 -c 'import secrets; print(secrets.token_urlsafe(48))'

AEGIS_SECRET_KEY=change-me-to-a-long-random-value-generated-locally
POSTGRES_PASSWORD=change-me-too

# Optional: enable the LLM-backed analyst (otherwise a deterministic engine is used)
AEGIS_ANTHROPIC_API_KEY=
AEGIS_ASSISTANT_MODEL=claude-opus-5-5

# Optional: external IP reputation (public IPs only, cached 24h)
AEGIS_INTEL_EXTERNAL_ENABLED=false
AEGIS_ABUSEIPDB_API_KEY=

# Response actions: allow the requester to approve their own request. Keep false when more
# than one administrator exists; true is convenient for a single-person lab.
AEGIS_RESPONSE_ALLOW_SELF_APPROVAL=true

# Gateway port on the host
AEGIS_HTTP_PORT=8080
